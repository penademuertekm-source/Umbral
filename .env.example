# Variables de entorno de Umbral (copia este archivo como .env.local para usarlas en tu computador).
# No hay claves ni secretos: la app no usa ninguna.

# Ruta base de la publicación. En local es "/"; el flujo de GitHub Pages usa "/Umbral/".
VITE_BASE=/

# Dirección pública de la app. La usarán los códigos QR de las placas (Fase 8, en pausa).
VITE_URL_PUBLICA=https://penademuertekm-source.github.io/Umbral/
